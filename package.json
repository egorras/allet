{
  "name": "allet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.20.0 <23"
  },
  "scripts": {
    "dev": "pnpm --filter @allet/web dev",
    "build": "pnpm --filter @allet/web build",
    "preview": "pnpm --filter @allet/web preview",
    "typecheck": "pnpm --filter @allet/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "pnpm --filter @allet/web test:unit",
    "test:e2e": "pnpm --filter @allet/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
